# ============================================================
# VELVET-HAVEN ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ============================================================

# ============================================================
# Backend API Configuration
# ============================================================
# Replace with your backend API base URL
# Local Development: http://localhost:5000/api
# Production: https://api.velvet-haven.com/api
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000/api

# ============================================================
# Cloudinary Image CDN Configuration
# ============================================================
# Base URL for loading images from Cloudinary
# Sign up at: https://cloudinary.com
# Format: https://res.cloudinary.com/{CLOUD_NAME}/image/upload/
# Get your Cloud Name from: Cloudinary Dashboard → Settings
NEXT_PUBLIC_IMAGE_URL=https://res.cloudinary.com/your-cloud-name/image/upload

# ============================================================
# Razorpay Payment Gateway
# ============================================================
# Razorpay Public Key (NOT Secret Key - that goes in backend)
# Get from: https://dashboard.razorpay.com/app/keys
# Test Key Format: rzp_test_xxxxxxxxxxxxx
# Live Key Format: rzp_live_xxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxx

# ============================================================
# Optional: Other Third-Party Services
# ============================================================
# Add any other API keys, service URLs, or configuration here
# as needed for your setup

# Example for Google Analytics or similar:
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Example for API rate limiting or feature flags:
# NEXT_PUBLIC_API_TIMEOUT=30000
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

